rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Global Safety Net - Default Deny
    match /{document=**} {
      allow read, write: if false;
    }

    // --- Primitives & Globals ---
    function isSignedIn() {
      return request.auth != null;
    }
    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }
    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }
    function incoming() {
      return request.resource.data;
    }
    function existing() {
      return resource.data;
    }

    // --- Validation Blueprints ---
    
    // User Profile Validation
    function isValidUserProfile(data) {
      return data.keys().hasAll(['updatedAt']) &&
             // Limit total keys to prevent shadow fields
             data.keys().size() <= 6 &&
             (data.get('displayName', '') is string && data.get('displayName', '').size() <= 100) &&
             (data.get('interests', []) is list && data.get('interests', []).size() <= 50) &&
             (data.get('updatedAt', request.time) == request.time);
    }

    // Memory Entry Validation
    function isValidMemoryEntry(data) {
      return data.keys().hasAll(['content', 'category', 'createdAt']) &&
             // Strict size for creation (content, category, createdAt, importance)
             data.keys().size() <= 4 &&
             data.content is string && data.content.size() <= 1000 &&
             data.category is string && data.category.size() <= 50 &&
             data.createdAt == request.time &&
             (data.get('importance', 3) is int && data.get('importance', 3) >= 1 && data.get('importance', 3) <= 5);
    }

    // Conversation Message Validation
    function isValidConversationMessage(data) {
      return data.keys().hasAll(['role', 'content', 'createdAt']) &&
             data.keys().size() <= 3 &&
             data.role is string && data.role.matches('^(user|assistant)$') &&
             data.content is string && data.content.size() <= 5000 &&
             data.createdAt == request.time;
    }

    // Note Validation
    function isValidNote(data) {
      return data.keys().hasAll(['content', 'tags', 'createdAt']) &&
             data.keys().size() <= 3 &&
             data.content is string && data.content.size() <= 10000 &&
             data.tags is list && data.tags.size() <= 20 &&
             data.createdAt == request.time;
    }

    // Project Validation
    function isValidProject(data) {
      return data.keys().hasAll(['name', 'status', 'lastAction', 'updatedAt']) &&
             data.keys().size() <= 5 &&
             data.name is string && data.name.size() <= 100 &&
             data.status is string && data.status.matches('^(en cours|en pause|terminé)$') &&
             data.lastAction is string && data.lastAction.size() <= 1000 &&
             (!data.keys().hasAny(['nextSteps']) || (data.nextSteps is string && data.nextSteps.size() <= 1000)) &&
             data.updatedAt == request.time;
    }

    // Daily Summary Validation
    function isValidDailySummary(data) {
      return data.keys().hasAll(['summary', 'sessionId', 'createdAt']) &&
             data.keys().size() <= 3 &&
             data.summary is string && data.summary.size() <= 2000 &&
             data.sessionId is string &&
             data.createdAt == request.time;
    }

    // --- Collection Rules ---
    match /users/{userId} {
      // Basic profile access
      allow get: if isOwner(userId) && isValidId(userId);
      
      allow create: if isOwner(userId) && isValidId(userId) && 
                      incoming().keys().hasAll(['createdAt', 'updatedAt']) &&
                      incoming().createdAt == request.time &&
                      isValidUserProfile(incoming());
                      
      allow update: if isOwner(userId) && isValidId(userId) && 
                      isValidUserProfile(incoming()) &&
                      incoming().updatedAt == request.time &&
                      // Ensure createdAt is immutable
                      incoming().createdAt == existing().createdAt &&
                      incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'interests', 'updatedAt']);

      match /notes/{noteId} {
        allow read: if isOwner(userId);
        allow create: if isOwner(userId) && isValidId(userId) && isValidNote(incoming());
        allow delete: if isOwner(userId);
        allow update: if false;
      }

      match /projects/{projectId} {
        allow read: if isOwner(userId);
        allow create, update: if isOwner(userId) && isValidId(userId) && isValidProject(incoming());
        allow delete: if false;
      }

      match /memories/{memoryId} {
        // Only the owner can list or get their memories
        allow list, get: if isOwner(userId) && isValidId(userId);
        
        // Strict creation
        allow create: if isOwner(userId) && isValidId(userId) && 
                        isValidMemoryEntry(incoming());
        
        // Memories are essentially immutable to maintain integrity of AI notes
        allow update, delete: if false;
      }

      match /conversations/{sessionId}/messages/{messageId} {
        allow list, get: if isOwner(userId) && isValidId(userId);

        allow create: if isOwner(userId) && isValidId(userId) && 
                        isValidConversationMessage(incoming());

        allow update, delete: if false;
      }

      match /daily_summaries/{date} {
        allow get: if isOwner(userId);
        allow create, update: if isOwner(userId) && 
                              isValidDailySummary(incoming());
      }
    }
  }
}
